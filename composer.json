{
    "name": "loanengine/login-register-starter",
    "type": "project",
    "description": "Minimal Laravel 12 login and registration starter with a reusable LoanEngine auth package.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "loanengine/auth": "^1.0",
        "laravel/tinker": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/loanengine/auth",
            "options": { "symlink": true }
        }
    ],
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
