
{
    "name": "loanengine/auth",
    "version": "1.0.0",
    "description": "Reusable LoanEngine authentication module",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
